!alp-version: 3.0.0

// WORKFLOW TEMPLATE
// Orchestrates sequential execution steps across autonomous agents.

@workflow
  id: wf-example-process
  name: "Example Process Workflow"
  goal: "Execute a multi-step lifecycle process automatically"
  !fail-strategy: rollback
  agents:
    - -> agent-planner
    - -> agent-developer
  steps:
    - "Planning: agent-planner executes task-example-plan"
    - "Implementation: agent-developer executes task-example-code"
