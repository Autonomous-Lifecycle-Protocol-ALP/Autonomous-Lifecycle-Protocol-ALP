!alp-version: 3.0.0

// TASK TEMPLATE
// Atomic units of work with status, difficulty, and verification rules.

@task
  id: task-example
  name: "Example Task"
  status: [ ]
  priority: medium
  difficulty: medium
  estimated_time: "4h"
  description: "Detailed instructions for the agent performing this task."
  feature: -> feat-example
  owner: -> agent-developer
  accept:
    - "Condition 1 is met"
    - "Condition 2 is met"
  verify_command: "npm test"
  verify_type: test
