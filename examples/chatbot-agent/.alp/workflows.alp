!alp-version: 3.0.0

@workflow
  id: wf-chat-interaction
  name: "User Chat Interaction"
  trigger: "on_message"
  steps:
    - id: step-analyze
      agent: agent-support
      action: "Determine intent and confidence"
    - id: step-fallback
      condition: "confidence < 0.7"
      agent: agent-researcher
      action: "Research deep context"
      depends_on: [step-analyze]
    - id: step-respond
      agent: agent-support
      action: "Format and return final answer"
      depends_on: [step-analyze, step-fallback]
