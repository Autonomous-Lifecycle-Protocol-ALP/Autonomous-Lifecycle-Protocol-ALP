{
  "name": "alp-monorepo",
  "version": "80.0.0",
  "description": "Autonomous Lifecycle Protocol (ALP) - The universal protocol for autonomous software engineering",
  "private": true,
  "workspaces": [
    "schemas",
    "parser",
    "cli",
    "sdk/*",
    "playground",
    "vscode",
    "docs-site",
    "mcp-server",
    "sham",
    "commercial/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspace @autonomous-lifecycle-protocol-alp/parser --workspace @autonomous-lifecycle-protocol-alp/cli --workspace @autonomous-lifecycle-protocol-alp/platform && vitest run",
    "test:python": "cd sdk/python && pytest",
    "typecheck": "npx tsc --noEmit --project parser/tsconfig.json && npx tsc --noEmit --project cli/tsconfig.json && npx tsc --noEmit --project sdk/typescript/tsconfig.json && npx tsc --noEmit --project commercial/alp-platform/tsconfig.json && npx tsc --noEmit --project vscode/server/tsconfig.json",
    "lint": "npm run lint --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP.git"
  },
  "keywords": [
    "alp",
    "protocol",
    "ai",
    "agent",
    "autonomous",
    "software-engineering"
  ],
  "author": "ALP Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP/issues"
  },
  "homepage": "https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP#readme",
  "devDependencies": {
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "react-icons": "^5.7.0"
  }
}
