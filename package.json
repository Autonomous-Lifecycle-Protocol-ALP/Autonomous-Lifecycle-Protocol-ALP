{
  "name": "alp-monorepo",
  "version": "44.0.0",
  "description": "Autonomous Lifecycle Protocol (ALP) - The universal protocol for autonomous software engineering",
  "private": true,
  "workspaces": [
    "schemas",
    "parser",
    "cli",
    "sdk/*",
    "playground",
    "vscode",
    "docs-site",
    "mcp-server",
    "sham"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build --workspace @autonomous-lifecycle-protocol-alp/parser --workspace @autonomous-lifecycle-protocol-alp/cli && vitest run",
    "test:python": "cd sdk/python && python -m unittest discover -s tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP.git"
  },
  "keywords": [
    "alp",
    "protocol",
    "ai",
    "agent",
    "autonomous",
    "software-engineering"
  ],
  "author": "ALP Contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP/issues"
  },
  "homepage": "https://github.com/Autonomous-Lifecycle-Protocol-ALP/Autonomous-Lifecycle-Protocol-ALP#readme",
  "devDependencies": {
    "vitest": "^4.1.10"
  }
}



